# scraper.vl — Web Scraper cho VietLang
# Su dung: vietlang scraper.vl <url> [output_file]

# ─── Kiem tra tham so ────────────────────────────────────────
tham_số = lay_tham_so()
do_dai_ts = do_dai(tham_số)

nếu do_dai_ts == 0 {
  in_mau("Cach dung: vietlang scraper.vl <url> [output_file]", "yellow")
  in_mau("Vi du:", "yellow")
  in_mau("  vietlang scraper.vl https://example.com", "yellow")
  in_mau("  vietlang scraper.vl https://example.com output.txt", "yellow")
  thoat()
}

url = tham_số[0]
file_output = "scraper_output.txt"
nếu do_dai_ts > 1 {
  file_output = tham_số[1]
}

# ─── Fetch HTML ──────────────────────────────────────────────
in_ra("Dang tai: " + url)
bắt_đầu = bay_gio()

thử {
  html = lay(url)
} ngoại_lệ (e) {
  in_mau("Loi khi tai: " + e, "red")
  thoat()
}

kết_thúc = bay_gio()
in_ra("Da tai xong: " + chuyen_chuoi(do_dai(html)) + " ky tu")

# ─── Trich xuat noi dung ─────────────────────────────────────
# Loai bo the HTML co ban
noi_dung = ""
trong_lenh = sai
idx = 0
do_dai_html = do_dai(html)

trong_lúc idx < do_dai_html {
  ky_tu = html[idx]
  
  nếu ky_tu == "<" {
    trong_lenh = sai
  } không_thì {
    nếu ky_tu == ">" {
      trong_lenh = đúng
    } không_thì {
      nếu trong_lenh {
        noi_dung = noi_dung + ky_tu
      }
    }
  }
  idx = idx + 1
}

# ─── Phan tich noi dung ──────────────────────────────────────
từ_list = tach_tu(noi_dung)
câu_list = tach_cau(noi_dung)
do_dai_từ = do_dai(từ_list)
do_dai_câu = do_dai(câu_list)

# ─── Hien thi ket qua ────────────────────────────────────────
in_ra("═══════════════════════════════════════════════════")
in_ra("  KET QUA SCRAPE")
in_ra("═══════════════════════════════════════════════════")
in_ra("URL: " + url)
in_ra("Thoi gian: " + bắt_đầu + " -> " + kết_thúc)
in_ra("Do dai HTML: " + chuyen_chuoi(do_dai(html)) + " ky tu")
in_ra("Do dai noi dung: " + chuyen_chuoi(do_dai(noi_dung)) + " ky tu")
in_ra("So tu: " + chuyen_chuoi(do_dai_từ))
in_ra("So cau: " + chuyen_chuoi(do_dai_câu))
in_ra("═══════════════════════════════════════════════════")

# ─── Luu vao file ─────────────────────────────────────────────
noi_dung_file = "URL: " + url + "\n"
noi_dung_file = noi_dung_file + "Thoi gian scrape: " + bắt_đầu + "\n"
noi_dung_file = noi_dung_file + "Do dai HTML: " + chuyen_chuoi(do_dai(html)) + " ky tu\n"
noi_dung_file = noi_dung_file + "So tu: " + chuyen_chuoi(do_dai_từ) + "\n"
noi_dung_file = noi_dung_file + "So cau: " + chuyen_chuoi(do_dai_câu) + "\n"
noi_dung_file = noi_dung_file + "\n--- NOI DUNG ---\n"
noi_dung_file = noi_dung_file + noi_dung + "\n"

thử {
  ghi_file(file_output, noi_dung_file)
  in_ra("Da luu vao: " + file_output)
} ngoại_lệ (e) {
  in_mau("Loi khi luu file: " + e, "red")
}


# watch_mode.vl — Theo dõi file .vl và tự chạy lại khi thay đổi
# Cách dùng: vietlang watch_mode.vl <file.vl>

tham_số = lấy_tham_số()
độ_dài_ts = độ_dài(tham_số)

nếu độ_dài_ts == 0 {
  in_mau("Cách dùng: vietlang watch_mode.vl <file.vl>", "yellow")
  in_ra("Ví dụ: vietlang watch_mode.vl demo\\bai_01.vl")
  thoát()
}

file_path = tham_số[0]

nếu không tồn_tại(file_path) {
  in_mau("Không tìm thấy file: " + file_path, "red")
  thoát()
}

xóa_màn_hình()
in_mau("═══════════════════════════════════════════", "cyan")
in_mau("  WATCH MODE — " + file_path, "cyan")
in_mau("═══════════════════════════════════════════", "cyan")
in_ra("")

nội_dung_cu = ""
lần_chạy = 0

trong_lúc đúng {
  thử {
    nội_dung_mới = đọc_file(file_path)
  } ngoại_lệ (e) {
    in_mau("Lỗi đọc file: " + e, "red")
    chạy_lệnh("ping -n 2 127.0.0.1 > nul")
    tiếp
  }

  nếu nội_dung_mới != nội_dung_cu {
    xóa_màn_hình()
    lần_chạy = lần_chạy + 1
    in_mau("═══════════════════════════════════════════", "cyan")
    in_mau("  WATCH MODE — " + file_path, "cyan")
    in_mau("═══════════════════════════════════════════", "cyan")
    in_ra("Lần chạy: " + chuyển_chuỗi(lần_chạy))
    in_ra("")
    nội_dung_cu = nội_dung_mới
    kết_quả = chạy_lệnh("vietlang.cmd " + file_path)
    nếu độ_dài(kết_quả) > 0 {
      in_ra(kết_quả)
    }
    in_ra("")
    in_mau("── Đang theo dõi... Ctrl+C để thoát ──", "yellow")
  }

  # Chờ ~1 giây rồi kiểm tra lại
  chạy_lệnh("ping -n 2 127.0.0.1 > nul")
}

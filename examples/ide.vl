# ide.vl — VietLang IDE
# Chạy: vietlang ide.vl

# ─── Biến toàn cục ─────────────────────────────────────────────
_file_path = ""
_is_modified = sai

# ─── Hàm tạo giao diện ──────────────────────────────────────────
hàm tạo_giao_diện() {
  # Cửa sổ chính
  tao_cua_so("VietLang IDE", 900, 700)

  # ── Thanh công cụ (panel) ──
  toolbar = tao_panel()
  dat_kich_thuoc_widget(toolbar, 880, 40)
  dat_mau_nen(toolbar, "LightGray")

  btn_mở = tao_nut("Mở")
  btn_lưu = tao_nut("Lưu")
  btn_lưu_tên = tao_nut("Lưu thành")
  btn_chạy = tao_nut("Chạy")
  btn_xóa = tao_nut("Xóa output")

  dat_kich_thuoc_widget(btn_mở, 70, 30)
  dat_kich_thuoc_widget(btn_lưu, 70, 30)
  dat_kich_thuoc_widget(btn_lưu_tên, 90, 30)
  dat_kich_thuoc_widget(btn_chạy, 70, 30)
  dat_kich_thuoc_widget(btn_xóa, 90, 30)

  them_vao_panel(toolbar, btn_mở)
  them_vao_panel(toolbar, btn_lưu)
  them_vao_panel(toolbar, btn_lưu_tên)
  them_vao_panel(toolbar, btn_chạy)
  them_vao_panel(toolbar, btn_xóa)

  # ── Label đường dẫn file ──
  lbl_file = tao_nhan("Chưa mở file")
  dat_font(lbl_file, 9)

  # ── Code editor ──
  editor = tao_text_editor("")
  dat_kich_thuoc_widget(editor, 870, 380)

  # ── Label output ──
  lbl_output = tao_nhan("── Output ──")
  dat_font(lbl_output, 10)

  # ── Output area ──
  output = tao_output("")
  dat_kich_thuoc_widget(output, 870, 180)

  # ── Status bar ──
  status = tao_nhan("Sẵn sàng")
  dat_font(status, 9)
  dat_mau_nen(status, "WhiteSmoke")
}

# ─── Hàm mở file ────────────────────────────────────────────────
hàm mở_file() {
  path = hop_thoai_mo_file("VietLang (*.vl)|*.vl|All (*.*)|*.*")
  nếu path == "" {
    trả_về
  }
  _file_path = path
  nội_dung = doc_file(path)
  editor_ctrl = lay_widget("editor")
  nếu editor_ctrl != rỗng {
    dat_van_ban(editor_ctrl, nội_dung)
  }
  _is_modified = sai
 .lbl_file_ctrl = lay_widget("lbl_file")
  nếu .lbl_file_ctrl != rỗng {
    dat_van_ban(.lbl_file_ctrl, path)
  }
  trạng_thái("Đã mở: " + path)
}

# ─── Hàm lưu file ────────────────────────────────────────────────
hàm lưu_file() {
  nếu _file_path == "" {
    lưu_file_as()
    trả_về
  }
  editor_ctrl = lay_widget("editor")
  nếu editor_ctrl == rỗng {
    trả_về
  }
  nội_dung = lay_van_ban(editor_ctrl)
  ghi_file(_file_path, nội_dung)
  _is_modified = sai
  trạng_thái("Đã lưu: " + _file_path)
}

hàm lưu_file_as() {
  path = hop_thoai_luu_file("VietLang (*.vl)|*.vl|All (*.*)|*.*")
  nếu path == "" {
    trả_về
  }
  _file_path = path
  editor_ctrl = lay_widget("editor")
  nếu editor_ctrl == rỗng {
    trả_về
  }
  nội_dung = lay_van_ban(editor_ctrl)
  ghi_file(_file_path, nội_dung)
  _is_modified = sai
  lbl_file_ctrl = lay_widget("lbl_file")
  nếu lbl_file_ctrl != rỗng {
    dat_van_ban(lbl_file_ctrl, path)
  }
  trạng_thái("Đã lưu: " + path)
}

# ─── Hàm chạy code ──────────────────────────────────────────────
hàm chạy_code() {
  editor_ctrl = lay_widget("editor")
  output_ctrl = lay_widget("output")
  nếu editor_ctrl == rỗng hoặc output_ctrl == rỗng {
    trả_về
  }

  nội_dung = lay_van_ban(editor_ctrl)
  xoa_trong(output_ctrl)
  dat_van_ban(output_ctrl, "Đang chạy...\n")

  # Chạy code và ghi output
  thử {
    # Tạo file tạm
    file_tạm = "_ide_temp.vl"
    ghi_file(file_tạm, nội_dung)

    # Chạy qua vietlang
    kết_quả = chay_lenh("vietlang.cmd " + file_tạm)

    # Hiển thị output
    nếu do_dai(kết_quả) > 0 {
      them_dong(output_ctrl, kết_quả)
    } không_thì {
      them_dong(output_ctrl, "(không có output)")
    }

    # Xóa file tạm
    xoa_file(file_tạm)

    trạng_thái("Chạy xong!")
  } ngoại_lệ (e) {
    them_dong(output_ctrl, "Lỗi: " + e)
    trạng_thái("Có lỗi!")
  }
}

# ─── Hàm trạng thái ──────────────────────────────────────────────
hàm trạng_thái(text) {
  status_ctrl = lay_widget("status")
  nếu status_ctrl != rỗng {
    dat_van_ban(status_ctrl, text)
  }
}

hàm lay_widget(tên) {
  # Trả widget theo tên (simplified — trong thực tế cần registry)
  trả_về rỗng
}

# ─── Chạy IDE ────────────────────────────────────────────────────
tạo_giao_diện()
chay()

# test_math.vl — Math library golden test

# 1. can_bac_hai
nếu can_bac_hai(9) != 3 { ném("FAIL: can_bac_hai(9)") }

# 2. tuyet_doi
nếu tuyet_doi(-5) != 5 { ném("FAIL: tuyet_doi(-5)") }

# 3. toi_da
nếu toi_da(3, 7) != 7 { ném("FAIL: toi_da(3,7)") }

# 4. toi_thieu
nếu toi_thieu(3, 7) != 3 { ném("FAIL: toi_thieu(3,7)") }

# 5. sin(0) == 0
nếu sin(0) != 0 { ném("FAIL: sin(0)") }

# 6. cos(0) == 1
nếu cos(0) != 1 { ném("FAIL: cos(0)") }

# 7. log(E) == 1
nếu log(E) != 1 { ném("FAIL: log(E)") }

# 8. log2(8) == 3
nếu log2(8) != 3 { ném("FAIL: log2(8)") }

# 9. log10(100) == 2
nếu log10(100) != 2 { ném("FAIL: log10(100)") }

# 10. lam_tron(1.5) == 2
nếu lam_tron(1.5) != 2 { ném("FAIL: lam_tron(1.5)") }

# 11. lam_nguyen(1.7) == 1
nếu lam_nguyen(1.7) != 1 { ném("FAIL: lam_nguyen(1.7)") }

# 12. so_nguyen
nếu so_nguyen(5) != đúng { ném("FAIL: so_nguyen(5)") }
nếu so_nguyen(1.5) != sai { ném("FAIL: so_nguyen(1.5)") }

# 13. PI range
nếu PI <= 3.14 { ném("FAIL: PI too small") }
nếu PI >= 3.15 { ném("FAIL: PI too large") }

in_ra("PASS: all math tests")

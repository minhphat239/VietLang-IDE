# script_runner.vl — chạy file .vl với error display đẹp
# Chạy: vietlang script_runner.vl <file.vl>

tham_số = lay_tham_so()
do_dai_ts = do_dai(tham_số)

nếu do_dai_ts == 0 {
  in_mau("Cách dùng: vietlang script_runner.vl <file.vl>", "yellow")
  in_mau("Tùy chọn: --time  (hiển thị thời gian chạy)", "yellow")
  thoat()
}

file_path = ""
hien_thi_thoi_gian = sai

idx = 0
trong_lúc idx < do_dai_ts {
  arg = tham_số[idx]
  nếu arg == "--time" {
    hien_thi_thoi_gian = đúng
  } không_thì {
    file_path = arg
  }
  idx = idx + 1
}

nếu file_path == "" {
  in_mau("Thiếu file path!", "red")
  thoat()
}

nếu không ton_tai(file_path) {
  in_mau("Không tìm thấy file: " + file_path, "red")
  thoat()
}

bắt_đầu = ""
nếu hien_thi_thoi_gian {
  bắt_đầu = chay_lenh("powershell -Command (Get-Date).Ticks")
}

kết_quả = chay_lenh("vietlang.cmd " + file_path)

nếu hien_thi_thoi_gian {
  kt = chay_lenh("powershell -Command (Get-Date).Ticks")
  tg = (chuyen_so(kt) - chuyen_so(bắt_đầu)) / 10000
  in_mau("Thời gian: " + chuyen_chuoi(tg) + "ms", "cyan")
}

vi_tri = tim_tu(kết_quả, "Lỗi")
nếu do_dai(vi_tri) > 0 {
  in_mau("═══════════════════════════════════════════════════", "red")
  in_mau("  LỖI: " + kết_quả, "red")
  in_mau("═══════════════════════════════════════════════════", "red")
} không_thì {
  nếu do_dai(kết_quả) > 0 {
    in_ra(kết_quả)
  }
}

# repl.vl — REPL cho VietLang IDE
# Chạy: vietlang repl.vl

_history = []
_REPL_VARS = ["_history", "_REPL_VARS", "hiển_thị_chào_mừng", "hiển_thị_trợ_giúp", "hiển_thị_lịch_sử", "hiển_thị_lỗi", "xóa_state", "lưu_state", "restore_state", "lưu_history", "restore_history", "_la_repl_var"]

hàm hiển_thị_chào_mừng() {
  xoa_man_hinh()
  in_mau("╔══════════════════════════════════════╗", "cyan")
  in_mau("║        VietLang REPL v1.0.0          ║", "cyan")
  in_mau("╚══════════════════════════════════════╝", "cyan")
  in_ra("")
  in_ra("Gõ lệnh để thực thi.")
  in_ra("Lệnh đặc biệt:")
  in_ra("  lịch_sử      — xem lịch sử lệnh")
  in_ra("  lưu_session  — lưu state ra file")
  in_ra("  xóa_session  — xóa file session")
  in_ra("  xóa_history  — xóa file history")
  in_ra("  xóa_state    — xóa lịch sử")
  in_ra("  trợ_giúp     — hiển thị hướng dẫn")
  in_ra("  thoat        — thoat khỏi REPL")
  in_ra("")
}

hàm hiển_thị_trợ_giúp() {
  in_mau("── Hướng dẫn ──", "yellow")
  in_ra("Nhập lệnh VietLang để thực thi.")
  in_ra("Các lệnh đặc biệt:")
  in_ra("  lịch_sử      — hiển thị tất cả lệnh đã nhap")
  in_ra("  lưu_session  — lưu biến hiện tại ra file .vlsession")
  in_ra("  xóa_session  — xóa file .vlsession")
  in_ra("  xóa_history  — xóa file .vlhistory")
  in_ra("  xóa_state    — xóa toàn bộ lịch sử")
  in_ra("  trợ_giúp     — hiển thị hướng dẫn này")
  in_ra("  thoat        — thoat khỏi REPL")
  in_ra("")
}

hàm hiển_thị_lịch_sử() {
  n = do_dai(_history)
  nếu n == 0 {
    in_ra("(chưa có lệnh nào)")
    trả_về
  }
  i = 0
  trong_lúc i < n {
    stt = chuyen_chuoi(i + 1)
    in_ra(stt + " │ " + _history[i])
    i = i + 1
  }
}

hàm xóa_state() {
  _history = []
  in_ra("Đã xóa lịch sử.")
}

hàm hiển_thị_lỗi(e, lenh) {
  thong_bao = chuyen_chuoi(e)
  in_ra("")

  so_dong = thay_the(thong_bao, ".*dòng ([0-9]+).*", "$1")

  nếu so_dong != thong_bao {
    in_mau("  ✗ " + thong_bao, "red")
    in_mau("    -> Dòng " + so_dong, "yellow")
    nếu lenh != rỗng và lenh != "" {
      so = chuyen_so(so_dong)
      con_lai = lenh
      i = 0
      trong_lúc i < so - 1 {
        con_lai = thay_the(con_lai, "^[^\n]*\n?", "")
        i = i + 1
      }
      dong_source = thay_the(con_lai, "^([^\n]*).*", "$1")
      nếu dong_source != "" {
        in_ra("    | " + dong_source)
      }
    }
  } không_thì {
    in_mau("  ✗ " + thong_bao, "red")
  }
  in_ra("")
}

hàm _la_repl_var(ten) {
  với repl_var trong _REPL_VARS {
    nếu repl_var == ten {
      trả_về đúng
    }
  }
  trả_về sai
}

hàm lưu_state() {
  tat_ca = lay_tat_ca_bien()
  state = {}
  dem = 0
  với key trong tat_ca {
    nếu _la_repl_var(key) == sai {
      state[key] = tat_ca[key]
      dem = dem + 1
    }
  }
  thử {
    noi_dung = json_gop(state)
    ghi_file(".vlsession", noi_dung)
    in_ra("Đã lưu session (" + chuyen_chuoi(dem) + " biến).")
  } ngoại_lệ (e) {
    in_mau("Lỗi khi lưu session: " + e, "red")
  }
}

hàm restore_state() {
  nếu ton_tai(".vlsession") {
    thử {
      noi_dung = doc_file(".vlsession")
      state = json_phan_tach(noi_dung)
      dem = 0
      với key trong state {
        gan_bien(key, state[key])
        dem = dem + 1
      }
      in_ra("Đã restore session (" + chuyen_chuoi(dem) + " biến).")
    } ngoại_lệ (e) {
      in_mau("Không thể restore session: " + e, "red")
    }
  }
}

hàm lưu_history() {
  thử {
    trong_lúc do_dai(_history) > 1000 {
      mảng_mới = []
      i = 1
      trong_lúc i < do_dai(_history) {
        them(mảng_mới, _history[i])
        i = i + 1
      }
      _history = mảng_mới
    }
    noi_dung = json_gop(_history)
    ghi_file(".vlhistory", noi_dung)
  } ngoại_lệ (e) {
    in_mau("Lỗi khi lưu history: " + e, "red")
  }
}

hàm restore_history() {
  nếu ton_tai(".vlhistory") {
    thử {
      noi_dung = doc_file(".vlhistory")
      _history = json_phan_tach(noi_dung)
    } ngoại_lệ (e) {
      in_mau("Không thể restore history: " + e, "red")
    }
  }
}

restore_history()
restore_state()
hiển_thị_chào_mừng()

trong_lúc đúng {
  in_mau(">>> ", "green")
  lệnh = nhap()
  nếu lệnh == rỗng {
    lưu_history()
    thoat()
  }
  nếu lệnh == "" {
    lưu_history()
    thoat()
  }
  nếu lệnh == "thoat" {
    in_ra("Tạm biệt!")
    lưu_history()
    thoat()
  }
  nếu lệnh == "lịch_sử" {
    hiển_thị_lịch_sử()
    tiếp
  }
  nếu lệnh == "lưu_session" {
    lưu_state()
    tiếp
  }
  nếu lệnh == "xóa_session" {
    nếu ton_tai(".vlsession") {
      thử {
        chay_lenh("del .vlsession")
        in_ra("Đã xóa file .vlsession.")
      } ngoại_lệ (e) {
        in_mau("Lỗi khi xóa session: " + e, "red")
      }
    } không_thì {
      in_ra("Không có file session nào.")
    }
    tiếp
  }
  nếu lệnh == "xóa_state" {
    xóa_state()
    tiếp
  }
  nếu lệnh == "xóa_history" {
    nếu ton_tai(".vlhistory") {
      thử {
        chay_lenh("del .vlhistory")
        in_ra("Đã xóa file .vlhistory.")
      } ngoại_lệ (e) {
        in_mau("Lỗi khi xóa history: " + e, "red")
      }
    } không_thì {
      in_ra("Không có file history nào.")
    }
    tiếp
  }
  nếu lệnh == "trợ_giúp" {
    hiển_thị_trợ_giúp()
    tiếp
  }
  them(_history, lệnh)
  thử {
    thuc_thi(lệnh)
  } ngoại_lệ (e) {
    hiển_thị_lỗi(e, lệnh)
  }
}

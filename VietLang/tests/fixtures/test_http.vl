# Test HTTP builtins
thử {
    # Test lay() - GET request
    res = lay("https://httpbin.org/get")
    nếu(res.chua("origin")) {
        in_ra("GET OK")
    } không_thì {
        ném("GET failed: no origin")
    }

    # Test gui() - POST JSON
    res2 = gui("https://httpbin.org/post", "test")
    nếu(res2.chua("data")) {
        in_ra("POST OK")
    } không_thì {
        ném("POST failed: no data")
    }

    # Test gui_chuoi() - POST custom content type
    res3 = gui_chuoi("https://httpbin.org/post", "hello", "text/plain")
    nếu(chuyen_chuoi(res3).do_dai() > 0) {
        in_ra("POST_CUSTOM OK")
    } không_thì {
        ném("POST_CUSTOM failed: empty response")
    }
} ngoại_lệ (e) {
    in_ra("HTTP_ERROR: " + e)
}

# Test lay() with invalid URL - should not crash
thử {
    lay("https://invalid.example.com")
    in_ra("INVALID should have failed")
} ngoại_lệ (e) {
    in_ra("INVALID OK")
}

in_ra("PASS: http tests")
